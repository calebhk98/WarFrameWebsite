#!/usr/bin/env sh
# pre-push — local CI gate
#
# Runs the same checks as the GitHub Actions build + validate-html +
# bundle-size jobs, in the same order, fail-fast.
#
# Skipped intentionally:
#   - lighthouse  (cloud-flaky; continue-on-error in CI)
#   - e2e / playwright  (slow; cloud has Playwright grid)
#
# Emergency escape valve:
#   git push --no-verify
#
# Reserved for cases where CI is the only safe place to test (e.g. a
# platform-specific runner dependency). Subagents MUST NOT use
# --no-verify without an explicit instruction from the human operator.

set -e

echo "[pre-push] Running local CI gate..."

echo "[pre-push] 1/5  typecheck"
pnpm typecheck

echo "[pre-push] 2/5  build"
pnpm build

echo "[pre-push] 3/5  test"
pnpm test

echo "[pre-push] 4/5  html:check"
pnpm html:check

echo "[pre-push] 5/5  bundle:check"
pnpm bundle:check

echo "[pre-push] All checks passed. Proceeding with push."
