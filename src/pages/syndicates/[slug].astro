---
import { getCollection, render } from 'astro:content';
import Entity from '../../layouts/Entity.astro';
import AbilityCard from '../../components/AbilityCard.astro';
import Callout from '../../components/Callout.astro';

export async function getStaticPaths() {
  const syndicates = await getCollection('syndicates');
  return syndicates.map((s) => ({ params: { slug: s.slug }, props: { entry: s } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const components = { AbilityCard, Callout };

const tags = [
  data.type,
  ...(data.faction ? [data.faction] : []),
  ...(data.dailyCap ? [`${data.dailyCap} daily cap`] : []),
];
---

<Entity
  title={data.name}
  kind="syndicate"
  tags={tags}
  sources={data.sources}
>
  <Content components={components} />
</Entity>
