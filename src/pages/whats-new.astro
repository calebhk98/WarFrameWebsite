---
import Base from '../layouts/Base.astro';
import { updates } from '../data/updates';

const base = import.meta.env.BASE_URL;
---

<Base title="What's New" description="Timeline of major Warframe updates and new content releases">
  <div class="max-w-4xl mx-auto px-4 py-10">
    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold text-brand-cream mb-3">What's New</h1>
      <p class="text-brand-cream/60 text-lg">
        A chronological record of major Warframe updates -- new Warframes, quests, open worlds, and game-changing mechanics.
      </p>
    </header>

    <ol class="relative border-l border-surface-3 space-y-12 pl-6">
      {updates.map((entry) => (
        <li class="relative">
          <span class="absolute -left-3 top-1.5 w-5 h-5 rounded-full bg-brand-orange border-2 border-brand-black flex items-center justify-center">
            <span class="sr-only">Update marker</span>
          </span>

          <div class="ml-2">
            <p class="text-xs text-brand-cream/40 uppercase tracking-widest mb-1">
              {entry.updateNumber} &mdash; {new Date(entry.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <h2 class="text-xl font-bold text-brand-cream mb-2">{entry.title}</h2>
            <p class="text-brand-cream/70 mb-4 leading-relaxed">{entry.summary}</p>

            <ul class="flex flex-wrap gap-2 mb-4">
              {entry.highlights.map((hl) => (
                <li class="text-xs px-2 py-1 rounded bg-surface-2 border border-surface-3 text-brand-cream/70">
                  {hl}
                </li>
              ))}
            </ul>

            <div class="flex flex-wrap gap-4 text-sm">
              {entry.relatedSlug && entry.relatedType && (
                <a
                  href={`${base}${entry.relatedType}/${entry.relatedSlug}`}
                  class="text-brand-orange hover:underline"
                >
                  View {entry.relatedType.replace(/s$/, '')} page &rarr;
                </a>
              )}
              <a
                href={entry.fandomUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-cream/50 hover:text-brand-cream hover:underline"
              >
                Fandom wiki &rarr;
              </a>
            </div>
          </div>
        </li>
      ))}
    </ol>

    <footer class="mt-16 pt-8 border-t border-surface-3 text-sm text-brand-cream/40">
      <p>
        Update dates and details sourced from the Warframe wiki (warframe.fandom.com). This site is unofficial and not affiliated with Digital Extremes.
      </p>
    </footer>
  </div>
</Base>
