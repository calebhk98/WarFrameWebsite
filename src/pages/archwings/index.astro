---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntityCard from '../../components/EntityCard.astro';
import { getEntityImageUrl } from '../../lib/wfcd-images';

const base = import.meta.env.BASE_URL;
const archwings = await getCollection('archwings');
const sorted = [...archwings].sort((a, b) => a.data.name.localeCompare(b.data.name));

type ArchwingType = 'archwing' | 'archgun' | 'archmelee';

interface Group {
  label: string;
  types: ArchwingType[];
  desc: string;
}

const groups: Group[] = [
  {
    label: 'Archwings',
    types: ['archwing'],
    desc: 'Space-combat mobility suits with active abilities',
  },
  {
    label: 'Arch-guns',
    types: ['archgun'],
    desc: 'Primary weapons used in Archwing and Railjack combat',
  },
  {
    label: 'Arch-melees',
    types: ['archmelee'],
    desc: 'Close-quarters melee weapons for Archwing combat',
  },
];

function itemsForGroup(types: ArchwingType[]) {
  return sorted.filter((a) => types.includes(a.data.type as ArchwingType));
}
---

<Base
  title="Archwings"
  description="All Warframe Archwings, Arch-guns, and Arch-melees -- stats, abilities, and acquisition"
>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-brand-cream mb-2">Archwings</h1>
      <p class="text-brand-cream/60">
        {sorted.length} items -- Archwings, Arch-guns, and Arch-melees for space and aerial combat
      </p>
    </header>

    <nav aria-label="Archwing type groups" class="flex flex-wrap gap-2 mb-8">
      {groups.map((g) => (
        <a
          href={`#group-${g.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          class="text-xs px-2 py-1 rounded bg-surface-2 border border-surface-3 text-brand-cream/70 hover:text-brand-orange hover:border-brand-orange/50 transition-colors"
        >
          {g.label}
        </a>
      ))}
    </nav>

    {groups.map((g) => {
      const items = itemsForGroup(g.types);
      if (items.length === 0) return null;
      return (
        <section
          id={`group-${g.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          class="mb-12"
        >
          <div class="mb-4 border-b border-surface-3 pb-2">
            <h2 class="text-sm uppercase tracking-widest text-brand-orange font-semibold">
              {g.label}
            </h2>
            <p class="text-xs text-brand-cream/50 mt-1">{g.desc}</p>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
            {items.map((item) => (
              <EntityCard
                href={`${base}archwings/${item.slug}`}
                name={item.data.name}
                tags={[`MR ${item.data.masteryRank}`]}
                image={getEntityImageUrl(item.slug, 'archwings')}
              />
            ))}
          </div>
        </section>
      );
    })}
  </div>
</Base>
