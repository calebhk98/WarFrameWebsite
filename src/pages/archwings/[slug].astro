---
import { getCollection, render } from 'astro:content';
import Entity from '../../layouts/Entity.astro';
import Callout from '../../components/Callout.astro';
import AbilityCard from '../../components/AbilityCard.astro';
import StatBlock from '../../components/StatBlock.astro';
import { getEntityImageUrl } from '../../lib/wfcd-images';

export async function getStaticPaths() {
  const archwings = await getCollection('archwings');
  return archwings.map((a) => ({ params: { slug: a.slug }, props: { entry: a } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const components = { Callout, AbilityCard, StatBlock };

const { data } = entry;
const thumbnailUrl = getEntityImageUrl(entry.slug, 'archwings') ?? null;

const healthStr = typeof data.health === 'number' ? String(data.health) : data.health;
const shieldStr = typeof data.shield === 'number' ? String(data.shield) : data.shield;
const armorStr = typeof data.armor === 'number' ? String(data.armor) : data.armor;

const description =
  data.type === 'archwing'
    ? `${data.name} -- Health ${healthStr}, Shield ${shieldStr}, Armor ${armorStr} -- Archwing`
    : `${data.name} -- MR ${data.masteryRank} -- ${data.type}`;

const tags: string[] = [data.type, `MR ${data.masteryRank}`];
---

<Entity
  title={data.name}
  kind="archwing"
  description={description}
  tags={tags}
  sources={data.sources}
  thumbnailUrl={thumbnailUrl}
>
  <Content components={components} />
</Entity>
