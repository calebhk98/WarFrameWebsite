---
import Base from '../../layouts/Base.astro';
import EntityCard from '../../components/EntityCard.astro';
import { getRelicEnumeration } from '../../lib/enumerations';

const relics = getRelicEnumeration();

// Group by era
const byEra: Record<string, typeof relics> = {};
for (const r of relics) {
  const era = r.era ?? 'unknown';
  if (!byEra[era]) byEra[era] = [];
  byEra[era]!.push(r);
}

const eraOrder = ['lith', 'meso', 'neo', 'axi', 'requiem', 'unknown'];
const eras = eraOrder.filter((e) => byEra[e]);

// Show first 50 per era to avoid massive pages
const PREVIEW_COUNT = 50;
---

<Base title="Relics" description="All 2682 void relics organised by era">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-brand-cream mb-2">Relics</h1>
      <p class="text-brand-cream/60">
        {relics.length} void relics grouped by era (showing first {PREVIEW_COUNT} per era)
      </p>
    </header>

    <nav aria-label="Era index" class="flex flex-wrap gap-2 mb-8">
      {eras.map((era) => (
        <a
          href={`#era-${era}`}
          class="text-xs px-2 py-1 rounded bg-surface-2 border border-surface-3 text-brand-cream/70 hover:text-brand-orange hover:border-brand-orange/50 transition-colors capitalize"
        >
          {era}
        </a>
      ))}
    </nav>

    {eras.map((era) => {
      const eraRelics = byEra[era]!;
      const preview = eraRelics.slice(0, PREVIEW_COUNT);
      return (
        <section id={`era-${era}`} class="mb-10">
          <h2 class="text-sm uppercase tracking-widest text-brand-orange font-semibold mb-4 border-b border-surface-3 pb-2 capitalize">
            {era} ({eraRelics.length} relics)
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
            {preview.map((r) => (
              <EntityCard
                href="#"
                name={r.name}
                tags={[r.era ?? 'unknown'].filter(Boolean)}
              />
            ))}
          </div>
          {eraRelics.length > PREVIEW_COUNT && (
            <p class="mt-3 text-sm text-brand-cream/50">
              ... and {eraRelics.length - PREVIEW_COUNT} more {era} relics.
            </p>
          )}
        </section>
      );
    })}
  </div>
</Base>
