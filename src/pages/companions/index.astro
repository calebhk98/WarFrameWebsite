---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntityCard from '../../components/EntityCard.astro';

const base = import.meta.env.BASE_URL;
const companions = await getCollection('companions');
const sorted = [...companions].sort((a, b) => a.data.name.localeCompare(b.data.name));

type CompanionType =
  | 'sentinel'
  | 'kubrow'
  | 'kavat'
  | 'vulpaphyla'
  | 'predasite'
  | 'moa'
  | 'hound'
  | 'infested-companion';

interface Group {
  label: string;
  types: CompanionType[];
}

const groups: Group[] = [
  { label: 'Sentinels', types: ['sentinel'] },
  { label: 'Kubrows and Kavats', types: ['kubrow', 'kavat', 'infested-companion'] },
  { label: 'Modular (Vulpaphyla, Predasite, MOA)', types: ['vulpaphyla', 'predasite', 'moa'] },
  { label: 'Hounds', types: ['hound'] },
];

function companionsForGroup(types: CompanionType[]) {
  return sorted.filter((c) => types.includes(c.data.type as CompanionType));
}
---

<Base title="Companions" description="All Warframe companions -- Sentinels, Kubrows, Kavats, Vulpaphylas, Predasites, MOAs, and Hounds">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-brand-cream mb-2">Companions</h1>
      <p class="text-brand-cream/60">
        {sorted.length} companions -- Sentinels, Kubrows, Kavats, Vulpaphylas, Predasites, MOAs, and Hounds
      </p>
    </header>

    <nav aria-label="Companion type groups" class="flex flex-wrap gap-2 mb-8">
      {groups.map((g) => (
        <a
          href={`#group-${g.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          class="text-xs px-2 py-1 rounded bg-surface-2 border border-surface-3 text-brand-cream/70 hover:text-brand-orange hover:border-brand-orange/50 transition-colors"
        >
          {g.label}
        </a>
      ))}
    </nav>

    {groups.map((g) => {
      const items = companionsForGroup(g.types);
      if (items.length === 0) return null;
      return (
        <section
          id={`group-${g.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          class="mb-12"
        >
          <h2 class="text-sm uppercase tracking-widest text-brand-orange font-semibold mb-4 border-b border-surface-3 pb-2">
            {g.label}
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
            {items.map((c) => (
              <EntityCard
                href={`${base}companions/${c.slug}`}
                name={c.data.name}
                tags={[c.data.type]}
              />
            ))}
          </div>
        </section>
      );
    })}
  </div>
</Base>
