---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntityCard from '../../components/EntityCard.astro';

const quests = await getCollection('quests');
const sorted = [...quests].sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Base title="Quests" description="All 43 Warframe quests — walkthroughs and lore">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-brand-cream mb-2">Quests</h1>
      <p class="text-brand-cream/60">{sorted.length} quests — story, objectives, and rewards</p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {sorted.map((q) => (
        <EntityCard
          href={`/quests/${q.slug}`}
          name={q.data.name}
          tags={[
            q.data.prerequisites.length > 0 ? `${q.data.prerequisites.length} prereq` : 'No prereqs',
            `${q.data.stages.length} stage${q.data.stages.length !== 1 ? 's' : ''}`,
          ]}
        />
      ))}
    </div>
  </div>
</Base>
