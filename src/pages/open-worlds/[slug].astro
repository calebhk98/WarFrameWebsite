---
import { getCollection, render } from 'astro:content';
import Entity from '../../layouts/Entity.astro';
import Callout from '../../components/Callout.astro';
import LinkOutFandom from '../../components/LinkOutFandom.astro';

export async function getStaticPaths() {
  const worlds = await getCollection('open-worlds');
  return worlds.map((w) => ({ params: { slug: w.slug }, props: { entry: w } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const components = { Callout, LinkOutFandom };

const tags = [
  data.location,
  data.syndicate_hub,
  ...(data.cycle ? [data.cycle] : []),
  `Lvl ${data.level_range.min}-${data.level_range.max}`,
];
---

<Entity
  title={data.name}
  kind="open-world"
  collectionHref={`${import.meta.env.BASE_URL}open-worlds`}
  collectionLabel="Open Worlds"
  tags={tags}
  sources={data.sources}
>
  <Content components={components} />
</Entity>
