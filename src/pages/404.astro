---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="Page not found" description="The page you are looking for does not exist">
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <p class="text-8xl font-bold text-brand-orange mb-6">404</p>
    <h1 class="text-3xl font-bold text-brand-cream mb-4">Page not found</h1>
    <p class="text-brand-cream/60 mb-8">
      The Lotus could not locate this resource. It may have been vaulted,
      relocated, or never existed.
    </p>
    <a
      href={base}
      class="inline-block px-6 py-3 rounded-lg bg-brand-orange text-brand-black font-semibold hover:bg-brand-orange/90 transition-colors"
    >
      Return to Codex
    </a>
  </div>
</Base>
