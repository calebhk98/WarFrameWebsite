---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;

const popularLinks = [
  { href: `${base}warframes`, label: 'All Warframes' },
  { href: `${base}tier-list`, label: 'Tier List' },
  { href: `${base}beginner`, label: 'Beginner Hub' },
  { href: `${base}builds`, label: 'Builds' },
  { href: `${base}guides`, label: 'Guides' },
  { href: `${base}whats-new`, label: "What's New" },
];
---

<Base title="Page not found" description="The page you are looking for does not exist">
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <p class="text-8xl font-bold text-brand-orange mb-6">404</p>
    <h1 class="text-3xl font-bold text-brand-cream mb-4">Page not found</h1>
    <p class="text-brand-cream/60 mb-8">
      The Lotus could not locate this resource. It may have been vaulted,
      relocated, or never existed.
    </p>

    <div id="pagefind-404" class="max-w-sm mx-auto mb-10"></div>

    <p class="text-sm text-brand-cream/40 mb-4 uppercase tracking-widest">Popular pages</p>
    <nav aria-label="Popular pages" class="flex flex-wrap justify-center gap-3">
      {popularLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm px-4 py-2 rounded-lg border border-surface-3 bg-surface-2 text-brand-cream/70 hover:border-brand-orange/50 hover:text-brand-orange transition-all"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="mt-10">
      <a
        href={base}
        class="inline-block px-6 py-3 rounded-lg bg-brand-orange text-brand-black font-semibold hover:bg-brand-orange/90 transition-colors"
      >
        Return to Codex
      </a>
    </div>
  </div>
</Base>

<script define:vars={{ base }} is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    const win = window;
    if (typeof win.PagefindUI !== 'undefined') {
      new win.PagefindUI({ element: '#pagefind-404', showImages: false });
    }
  });
</script>
