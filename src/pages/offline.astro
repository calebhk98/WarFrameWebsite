---
import Base from '../layouts/Base.astro';
---

<Base
  title="Offline"
  description="You are offline -- some pages may still be available from cache."
>
  <section class="flex flex-col items-center justify-center min-h-[60vh] px-6 text-center">
    <div class="max-w-lg">
      <svg
        class="mx-auto mb-8 w-24 h-24 text-brand-orange opacity-80"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M18.364 5.636a9 9 0 010 12.728M5.636 5.636a9 9 0 000 12.728M8.464 8.464a5 5 0 000 7.072M15.536 8.464a5 5 0 010 7.072M12 12h.01"
        />
      </svg>

      <h1 class="text-3xl font-bold text-brand-orange mb-4">You are offline</h1>

      <p class="text-brand-cream/80 text-lg mb-6">
        Some pages may still be available from cache. Try navigating to a page
        you have visited before, or come back when you have a connection.
      </p>

      <a
        href="/warframewebsite/"
        class="inline-block px-6 py-3 rounded bg-brand-orange text-brand-black font-semibold hover:bg-brand-orange/90 transition-colors"
      >
        Go to homepage
      </a>
    </div>
  </section>
</Base>
