---
import Base from '../../layouts/Base.astro';
import EntityCard from '../../components/EntityCard.astro';
import { getModEnumeration } from '../../lib/enumerations';

const mods = getModEnumeration();
const sorted = [...mods].sort((a, b) => a.name.localeCompare(b.name));

const byLetter: Record<string, typeof sorted> = {};
for (const m of sorted) {
  const letter = m.name[0]?.toUpperCase() ?? '#';
  if (!byLetter[letter]) byLetter[letter] = [];
  byLetter[letter]!.push(m);
}
const letters = Object.keys(byLetter).sort();
const base = import.meta.env.BASE_URL;
---

<Base title="Mods" description="Augment mod catalogue for Warframe">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <header class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-2">
        <div>
          <h1 class="text-3xl font-bold text-brand-cream mb-2">Mods</h1>
          <p class="text-brand-cream/60">
            {sorted.length} featured mods (augments). Full mod library browsable via WFCD data.
          </p>
        </div>
        <a href={`${base}market`} class="text-sm text-brand-orange hover:underline shrink-0">
          Trade Prices &rarr;
        </a>
      </div>
    </header>

    <nav aria-label="Alphabetical index" class="flex flex-wrap gap-2 mb-8">
      {letters.map((letter) => (
        <a
          href={`#letter-${letter}`}
          class="text-xs px-2 py-1 rounded bg-surface-2 border border-surface-3 text-brand-cream/70 hover:text-brand-orange hover:border-brand-orange/50 transition-colors"
        >
          {letter}
        </a>
      ))}
    </nav>

    {letters.map((letter) => (
      <section id={`letter-${letter}`} class="mb-10">
        <h2 class="text-sm uppercase tracking-widest text-brand-orange font-semibold mb-4 border-b border-surface-3 pb-2">
          {letter}
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
          {byLetter[letter]!.map((m) => (
            <EntityCard
              href="#"
              name={m.name}
              tags={[
                ...(m.rarity ? [m.rarity] : []),
                ...(m.isAugment ? ['Augment'] : []),
                ...(m.polarity ? [m.polarity] : []),
              ]}
            />
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
