---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;

interface StartingFrame {
  slug: string;
  name: string;
  role: string;
  summary: string;
  strength: string;
  fandomUrl: string;
}

const startingFrames: StartingFrame[] = [
  {
    slug: 'excalibur',
    name: 'Excalibur',
    role: 'Swordsman -- balanced melee',
    summary: 'The most straightforward starter. Exalted Blade turns your melee into a beam-emitting energy sword, trivialising early missions. Radial Blind gives crowd control without complicated mechanics.',
    strength: 'Best for players who enjoy melee combat and a straightforward power fantasy.',
    fandomUrl: 'https://warframe.fandom.com/wiki/Excalibur',
  },
  {
    slug: 'mag',
    name: 'Mag',
    role: 'Magnetism -- Corpus counter',
    summary: 'Mag excels against the Corpus faction with Magnetize, which creates a bubble that multiplies magnetic damage on enemies inside. Pull and Polarize strip shields in a wide radius.',
    strength: 'Best for players willing to learn faction weaknesses and deal burst-heavy damage.',
    fandomUrl: 'https://warframe.fandom.com/wiki/Mag',
  },
  {
    slug: 'volt',
    name: 'Volt',
    role: 'Electricity -- speed and versatility',
    summary: 'Speed is one of the most useful buffs in the game, permanently increasing movement and attack rate. Electric Shield supercharges firearms to devastating effect and helps the whole squad.',
    strength: 'Best for players who like fast-paced gameplay and buffing team damage.',
    fandomUrl: 'https://warframe.fandom.com/wiki/Volt',
  },
];

interface MilestoneGroup {
  range: string;
  title: string;
  goals: string[];
  tip: string;
}

const milestones: MilestoneGroup[] = [
  {
    range: 'MR 0-2',
    title: 'Get your footing',
    goals: [
      'Complete the Vor\'s Prize tutorial quest to unlock the Star Chart.',
      'Reach Earth > Mercury > Venus in order.',
      'Collect Mods from missions -- even unranked, they define your power.',
      'Identify your starter Warframe\'s main ability and use it constantly.',
    ],
    tip: 'Do not sell Mods. Duplicates are used to rank up -- you need three of the same Mod to max rank a basic card.',
  },
  {
    range: 'MR 3-5',
    title: 'Unlock the inner planets',
    goals: [
      'Unlock Mars, Jupiter, Saturn via Junctions.',
      'Complete "Howl of the Kubrow" to unlock your first companion.',
      'Farm a second Warframe -- Rhino from Jackal on Fossa, Venus is a popular early choice.',
      'Begin collecting Primed Mods from Baro Ki\'Teer trade events.',
    ],
    tip: 'Rhino\'s Iron Skin ability makes him almost invincible in early-game content. He is one of the best beginner frames to farm early.',
  },
  {
    range: 'MR 6-8',
    title: 'Chase the Void',
    goals: [
      'Unlock Void Relic cracking -- this is the primary way to obtain Prime Warframes and weapons.',
      'Complete "The Second Dream" quest -- a major story milestone that unlocks Operator mode.',
      'Install Orokin Reactors (Potato) on your two main Warframes to double their mod capacity.',
      'Unlock the Helminth Chrysalis at MR 8 to access ability subsumes.',
    ],
    tip: 'The Second Dream contains major story spoilers that recontextualise the entire game. Many players recommend avoiding spoilers until you play it.',
  },
  {
    range: 'MR 9-12',
    title: 'Open-world hubs',
    goals: [
      'Travel to Cetus on Earth to unlock Plains of Eidolon -- your first open world.',
      'Rank up Ostron standing to access Zaw weapon crafting.',
      'Unlock Fortuna on Venus for the Solaris United syndicate and Kitgun modular weapons.',
      'Complete "The War Within" quest -- unlocks Transference combat and Operator upgrades.',
    ],
    tip: 'Open-world hubs have daily standing caps. Log in daily and run bounties to steadily rank up syndicates.',
  },
  {
    range: 'MR 13-16',
    title: 'Endgame approach',
    goals: [
      'Unlock the Steel Path mode (all nodes completed) for a mastery challenge and permanent buff.',
      'Chase a meta-tier Warframe: Saryn Prime, Octavia Prime, or Mesa Prime are top choices.',
      'Forma your main Warframe 3-5 times to fit a full endgame mod loadout.',
      'Build an Arcane collection -- Arcane Energize and Arcane Guardian dramatically increase survivability.',
    ],
    tip: 'Steel Path nodes reward exclusive cosmetics and Kuva. They are not required to progress the story but are the main challenge for veterans.',
  },
];
---

<Base title="Beginner Hub" description="Starting guide for new Warframe players -- choose your first frame, master the early game, and progress efficiently">
  <div class="max-w-4xl mx-auto px-4 py-10">
    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold text-brand-cream mb-3">Beginner Hub</h1>
      <p class="text-brand-cream/60 text-lg">
        New to Warframe? This guide walks you from choosing your first frame to unlocking endgame. No spoilers for quests beyond what is needed for progression context.
      </p>
    </header>

    <section aria-labelledby="starters-heading" class="mb-14">
      <h2 id="starters-heading" class="text-2xl font-bold text-brand-cream mb-2">Choose your starter Warframe</h2>
      <p class="text-brand-cream/60 mb-6 text-sm">
        At account creation you choose one of three starter frames. All can eventually be obtained in-game for free; this is purely which you start with.
        Source: <a href="https://warframe.fandom.com/wiki/Starter_Warframes" target="_blank" rel="noopener noreferrer" class="text-brand-orange underline">Warframe wiki -- Starter Warframes</a>.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {startingFrames.map((frame) => (
          <div class="rounded-lg border border-surface-3 bg-surface-2 p-5 flex flex-col gap-3">
            <div>
              <h3 class="text-lg font-bold text-brand-cream">{frame.name}</h3>
              <p class="text-xs text-brand-orange uppercase tracking-wide">{frame.role}</p>
            </div>
            <p class="text-sm text-brand-cream/70 flex-1">{frame.summary}</p>
            <p class="text-xs text-brand-cream/80 italic">{frame.strength}</p>
            <div class="flex gap-3 text-sm flex-wrap">
              <a href={`${base}warframes/${frame.slug}`} class="text-brand-orange underline">
                View frame &rarr;
              </a>
              <a href={frame.fandomUrl} target="_blank" rel="noopener noreferrer" class="text-brand-cream/80 underline hover:text-brand-cream">
                Wiki &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="milestones-heading" class="mb-14">
      <h2 id="milestones-heading" class="text-2xl font-bold text-brand-cream mb-2">Mastery Rank progression</h2>
      <p class="text-brand-cream/60 mb-6 text-sm">
        Mastery Rank (MR) is gained by levelling Warframes and weapons to rank 30. Higher MR unlocks new gear and features.
        The first 20 MR ranks span roughly 300+ items. Focus on enjoying content rather than rushing MR.
      </p>
      <div class="space-y-6">
        {milestones.map((ms) => (
          <div class="rounded-lg border border-surface-3 bg-surface-2 overflow-hidden">
            <div class="bg-brand-purple/20 border-b border-surface-3 px-5 py-3 flex items-center gap-3">
              <span class="text-brand-orange font-bold text-sm uppercase tracking-wide whitespace-nowrap">{ms.range}</span>
              <h3 class="text-brand-cream font-semibold">{ms.title}</h3>
            </div>
            <div class="px-5 py-4">
              <ul class="list-disc list-inside space-y-1 text-sm text-brand-cream/75 mb-3">
                {ms.goals.map((g) => <li>{g}</li>)}
              </ul>
              <p class="text-xs text-brand-orange/80 bg-brand-orange/10 rounded px-3 py-2">
                Tip: {ms.tip}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="resources-heading">
      <h2 id="resources-heading" class="text-2xl font-bold text-brand-cream mb-4">Useful resources</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
        <a href={`${base}builds`} class="group rounded border border-surface-3 bg-surface-2 hover:border-brand-orange/50 p-4 transition-all">
          <p class="font-semibold text-brand-cream group-hover:text-brand-orange">Warframe Builds</p>
          <p class="text-brand-cream/80 mt-1">Curated mod loadouts for top-tier frames</p>
        </a>
        <a href={`${base}guides`} class="group rounded border border-surface-3 bg-surface-2 hover:border-brand-orange/50 p-4 transition-all">
          <p class="font-semibold text-brand-cream group-hover:text-brand-orange">Farming Guides</p>
          <p class="text-brand-cream/80 mt-1">Best nodes and strategies for resources and Prime parts</p>
        </a>
        <a href={`${base}warframes`} class="group rounded border border-surface-3 bg-surface-2 hover:border-brand-orange/50 p-4 transition-all">
          <p class="font-semibold text-brand-cream group-hover:text-brand-orange">All Warframes</p>
          <p class="text-brand-cream/80 mt-1">Browse every frame with stats and acquisition info</p>
        </a>
        <a href={`${base}tier-list`} class="group rounded border border-surface-3 bg-surface-2 hover:border-brand-orange/50 p-4 transition-all">
          <p class="font-semibold text-brand-cream group-hover:text-brand-orange">Tier List</p>
          <p class="text-brand-cream/80 mt-1">See which frames dominate the current meta</p>
        </a>
        <a href={`${base}damage-types`} class="group rounded border border-surface-3 bg-surface-2 hover:border-brand-orange/50 p-4 transition-all">
          <p class="font-semibold text-brand-cream group-hover:text-brand-orange">Damage Types</p>
          <p class="text-brand-cream/80 mt-1">Effectiveness matrix -- which damage beats which enemy</p>
        </a>
        <a href={`${base}riven-planner`} class="group rounded border border-surface-3 bg-surface-2 hover:border-brand-orange/50 p-4 transition-all">
          <p class="font-semibold text-brand-cream group-hover:text-brand-orange">Riven Roll Planner</p>
          <p class="text-brand-cream/80 mt-1">Calculate roll probability and stat values for Riven mods</p>
        </a>
      </div>
    </section>
  </div>
</Base>
