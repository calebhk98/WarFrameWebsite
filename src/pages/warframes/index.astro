---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntityCard from '../../components/EntityCard.astro';

const base = import.meta.env.BASE_URL;
const warframes = await getCollection('warframes');
const sorted = [...warframes].sort((a, b) => a.data.name.localeCompare(b.data.name));

// Group by initial letter
const byLetter: Record<string, typeof sorted> = {};
for (const w of sorted) {
  const letter = w.data.name[0]?.toUpperCase() ?? '#';
  if (!byLetter[letter]) byLetter[letter] = [];
  byLetter[letter]!.push(w);
}
const letters = Object.keys(byLetter).sort();
---

<Base title="Warframes" description="All 110 playable warframes with stats and abilities">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-brand-cream mb-2">Warframes</h1>
      <p class="text-brand-cream/60">{sorted.length} warframes — abilities, stats, acquisition</p>
    </header>

    <nav aria-label="Alphabetical index" class="flex flex-wrap gap-2 mb-8">
      {letters.map((letter) => (
        <a
          href={`#letter-${letter}`}
          class="text-xs px-2 py-1 rounded bg-surface-2 border border-surface-3 text-brand-cream/70 hover:text-brand-orange hover:border-brand-orange/50 transition-colors"
        >
          {letter}
        </a>
      ))}
    </nav>

    {letters.map((letter) => (
      <section id={`letter-${letter}`} class="mb-10">
        <h2 class="text-sm uppercase tracking-widest text-brand-orange font-semibold mb-4 border-b border-surface-3 pb-2">
          {letter}
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
          {byLetter[letter]!.map((w) => (
            <EntityCard
              href={`${base}warframes/${w.slug}`}
              name={w.data.name}
              tags={[
                `MR${w.data.masteryRank}`,
                ...(w.data.prime?.available ? ['Prime'] : []),
              ]}
            />
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
