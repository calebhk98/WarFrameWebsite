---
import Base from '../../layouts/Base.astro';
import EntityCard from '../../components/EntityCard.astro';
import { getMissionEnumeration } from '../../lib/enumerations';

const missions = getMissionEnumeration();
const sorted = [...missions].sort((a, b) => {
  const pa = a.planet ?? '';
  const pb = b.planet ?? '';
  if (pa !== pb) return pa.localeCompare(pb);
  return a.name.localeCompare(b.name);
});

// Group by planet
const byPlanet: Record<string, typeof sorted> = {};
for (const m of sorted) {
  const planet = m.planet ?? 'Unknown';
  if (!byPlanet[planet]) byPlanet[planet] = [];
  byPlanet[planet]!.push(m);
}
const planets = Object.keys(byPlanet).sort();
---

<Base title="Missions" description="All 260 mission nodes across the Warframe Star Chart">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-brand-cream mb-2">Missions</h1>
      <p class="text-brand-cream/60">{sorted.length} mission nodes grouped by planet</p>
    </header>

    <nav aria-label="Planet index" class="flex flex-wrap gap-2 mb-8">
      {planets.map((planet) => (
        <a
          href={`#planet-${planet.toLowerCase().replace(/\s+/g, '-')}`}
          class="text-xs px-2 py-1 rounded bg-surface-2 border border-surface-3 text-brand-cream/70 hover:text-brand-orange hover:border-brand-orange/50 transition-colors"
        >
          {planet}
        </a>
      ))}
    </nav>

    {planets.map((planet) => (
      <section id={`planet-${planet.toLowerCase().replace(/\s+/g, '-')}`} class="mb-10">
        <h2 class="text-sm uppercase tracking-widest text-brand-orange font-semibold mb-4 border-b border-surface-3 pb-2">
          {planet}
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
          {byPlanet[planet]!.map((m) => (
            <EntityCard
              href="#"
              name={m.name}
              tags={[
                ...(m.type && m.type !== 'Node' ? [m.type] : []),
                ...(m.levelRange ? [m.levelRange] : []),
                ...(m.faction && m.faction !== 'Node' ? [m.faction] : []),
              ].filter((t): t is string => Boolean(t))}
            />
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
