---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EntityCard from '../components/EntityCard.astro';
import WorldstateWidget from '../components/WorldstateWidget.astro';

const allWarframes = await getCollection('warframes');

const base = import.meta.env.BASE_URL;

const featuredSlugs = ['saryn-prime', 'mesa-prime', 'octavia-prime', 'rhino-prime', 'nova-prime', 'nekros-prime'];
const featured = featuredSlugs
  .map((s) => allWarframes.find((w) => w.slug === s))
  .filter((w): w is NonNullable<typeof w> => w !== undefined);

const quickLinks = [
  { href: `${base}builds`, label: 'Builds', desc: 'Optimised mod loadouts' },
  { href: `${base}guides`, label: 'Guides', desc: 'Farming and strategy' },
  { href: `${base}tier-list`, label: 'Tier List', desc: 'Meta frame rankings' },
  { href: `${base}beginner`, label: 'Beginner Hub', desc: 'Start here if you are new' },
];

const recentUpdates = [
  {
    href: `${base}whats-new`,
    title: 'The Lotus Eaters',
    update: 'Update 38',
    date: '2025-03-25',
    teaser: 'Expands the 1999 narrative with new Hex arcs and Hollvania content.',
  },
  {
    href: `${base}whats-new`,
    title: 'Warframe: 1999',
    update: 'Update 37',
    date: '2024-12-12',
    teaser: 'Arthur joins the roster; Hollvania open world and The Hex debut.',
  },
  {
    href: `${base}whats-new`,
    title: 'Jade Shadows',
    update: 'Update 36',
    date: '2024-06-18',
    teaser: 'Jade arrives with a new quest and Stalker rework.',
  },
];
---

<Base title="Home" description="Warframe Codex -- comprehensive fan reference for Warframe">
  <section class="relative bg-gradient-to-b from-brand-purple/20 to-transparent border-b border-surface-3 py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-5xl sm:text-6xl font-bold text-brand-cream mb-4">
        Warframe Codex
      </h1>
      <p class="text-xl text-brand-cream/70 max-w-2xl mx-auto mb-8">
        A data-driven fan reference for every Warframe entity. Stats sourced from WFCD. Unofficial.
      </p>
      <a
        href={`${base}warframes`}
        class="inline-block px-8 py-3 rounded-lg bg-brand-orange text-brand-black font-semibold text-lg hover:bg-brand-orange/90 transition-colors"
      >
        Explore the Codex
      </a>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 py-12 space-y-16">

    <section aria-labelledby="worldstate-heading">
      <h2 id="worldstate-heading" class="sr-only">Current worldstate</h2>
      <WorldstateWidget />
    </section>

    <section aria-labelledby="quick-links-heading">
      <h2 id="quick-links-heading" class="text-xl font-semibold text-brand-cream mb-6">
        Quick links
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {quickLinks.map((ql) => (
          <a
            href={ql.href}
            class="group rounded-lg border border-surface-3 bg-surface-2 hover:border-brand-orange/50 hover:bg-surface-3 p-5 transition-all text-center"
          >
            <p class="font-semibold text-brand-cream group-hover:text-brand-orange transition-colors">{ql.label}</p>
            <p class="text-xs text-brand-cream/50 mt-1">{ql.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="featured-warframes-heading">
      <div class="flex items-center justify-between mb-6">
        <h2 id="featured-warframes-heading" class="text-xl font-semibold text-brand-cream">
          Featured warframes
        </h2>
        <a href={`${base}warframes`} class="text-brand-orange hover:underline text-sm">
          Browse all &rarr;
        </a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        {featured.map((w) => (
          <EntityCard
            href={`${base}warframes/${w.slug}`}
            name={w.data.name}
            tags={w.data.acquisition?.source ? [w.data.acquisition.source] : []}
          />
        ))}
      </div>
    </section>

    <section aria-labelledby="recent-updates-heading">
      <div class="flex items-center justify-between mb-6">
        <h2 id="recent-updates-heading" class="text-xl font-semibold text-brand-cream">
          Recent updates
        </h2>
        <a href={`${base}whats-new`} class="text-brand-orange hover:underline text-sm">
          Full timeline &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {recentUpdates.map((u) => (
          <a
            href={u.href}
            class="group rounded-lg border border-surface-3 bg-surface-2 hover:border-brand-orange/50 hover:bg-surface-3 p-5 transition-all"
          >
            <p class="text-xs text-brand-cream/40 uppercase tracking-widest mb-1">{u.update} &mdash; {u.date}</p>
            <h3 class="font-semibold text-brand-cream group-hover:text-brand-orange transition-colors mb-2">{u.title}</h3>
            <p class="text-sm text-brand-cream/60">{u.teaser}</p>
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="collections-heading">
      <h2 id="collections-heading" class="text-xl font-semibold text-brand-cream mb-6">
        Browse collections
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { href: `${base}warframes`, label: 'Warframes', desc: '110 frames -- abilities, stats, builds' },
          { href: `${base}weapons`, label: 'Weapons', desc: '598 primary, secondary, and melee weapons' },
          { href: `${base}mods`, label: 'Mods', desc: 'Augments and featured mod catalogue' },
          { href: `${base}quests`, label: 'Quests', desc: '43 quests -- walkthroughs and lore' },
          { href: `${base}factions`, label: 'Factions', desc: '35 factions -- origins and weaknesses' },
          { href: `${base}syndicates`, label: 'Syndicates', desc: '18 syndicates -- standing and rewards' },
          { href: `${base}arcanes`, label: 'Arcanes', desc: '156 arcane enhancements' },
          { href: `${base}missions`, label: 'Missions', desc: '260 mission nodes across the Star Chart' },
          { href: `${base}resources`, label: 'Resources', desc: '224 crafting materials and drops' },
          { href: `${base}relics`, label: 'Relics', desc: '2682 void relics for prime farming' },
        ].map((col) => (
          <a
            href={col.href}
            class="group rounded-lg border border-surface-3 bg-surface-2 hover:border-brand-orange/50 hover:bg-surface-3 p-5 transition-all"
          >
            <h3 class="font-semibold text-brand-cream group-hover:text-brand-orange transition-colors mb-1">
              {col.label}
            </h3>
            <p class="text-sm text-brand-cream/60">{col.desc}</p>
          </a>
        ))}
      </div>
    </section>

  </div>
</Base>
