---
// Entity layout -- detail pages for warframes, factions, quests, syndicates
import Base from './Base.astro';

interface Source {
  url: string;
  accessedAt: string;
}

interface Props {
  title: string;
  kind: string;
  description?: string;
  tags?: string[];
  sources?: Source[];
}

const { title, kind, description, tags = [], sources = [] } = Astro.props;

const base = import.meta.env.BASE_URL;
const collectionPath = `${base}${kind}s`;
const collectionLabel = kind.charAt(0).toUpperCase() + kind.slice(1) + 's';
---

<Base title={title} description={description ?? `${title} -- Warframe Codex`}>
  <div class="max-w-5xl mx-auto px-4 py-8">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-brand-cream/50">
      <a href={base} class="hover:text-brand-orange transition-colors">Home</a>
      <span class="mx-2">/</span>
      <a href={collectionPath} class="hover:text-brand-orange transition-colors">{collectionLabel}</a>
      <span class="mx-2">/</span>
      <span class="text-brand-cream/80">{title}</span>
    </nav>

    <header class="mb-8 pb-6 border-b border-surface-3">
      <div class="flex items-start gap-4 flex-wrap">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs uppercase tracking-widest text-brand-orange font-semibold">
              {kind}
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-brand-cream mb-2">
            {title}
          </h1>
          {description && (
            <p class="text-brand-cream/70 text-lg leading-relaxed">{description}</p>
          )}
          {tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="text-xs px-2 py-1 rounded-full bg-surface-2 border border-surface-3 text-brand-cream/70">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    </header>

    <div class="flex gap-8 flex-col lg:flex-row">
      <article
        class="flex-1 min-w-0 prose prose-invert prose-headings:text-brand-cream prose-a:text-brand-orange prose-strong:text-brand-cream max-w-none"
        data-pagefind-body
        data-pagefind-meta={`title:${title},collection:${kind}`}
      >
        <slot />
      </article>

      {sources.length > 0 && (
        <aside class="lg:w-64 shrink-0">
          <div class="sticky top-20 rounded-lg border border-surface-3 bg-surface-2 p-4">
            <h2 class="text-xs uppercase tracking-widest text-brand-cream/50 font-semibold mb-3">
              Sources
            </h2>
            <ul class="space-y-2">
              {sources.map((src, i) => (
                <li class="text-xs">
                  <a
                    href={src.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-brand-orange hover:underline break-all"
                  >
                    [{i + 1}] {new URL(src.url).hostname}
                  </a>
                  <span class="block text-brand-cream/40 mt-0.5">
                    {src.accessedAt.slice(0, 10)}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </div>
</Base>
