---
// Header -- logo, nav links, Pagefind search input
// Pagefind UI is wired via postbuild; the div is always rendered.
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const primaryLinks = [
  { href: `${base}warframes`, label: 'Warframes' },
  { href: `${base}companions`, label: 'Companions' },
  { href: `${base}archwings`, label: 'Archwings' },
  { href: `${base}liches`, label: 'Liches' },
  { href: `${base}quests`, label: 'Quests' },
  { href: `${base}factions`, label: 'Factions' },
  { href: `${base}builds`, label: 'Builds' },
  { href: `${base}guides`, label: 'Guides' },
  { href: `${base}focus`, label: 'Focus' },
  { href: `${base}amps`, label: 'Amps' },
  { href: `${base}tier-list`, label: 'Tier List' },
  { href: `${base}beginner`, label: 'Beginner' },
  { href: `${base}worldstate`, label: 'Worldstate' },
];
---

<header class="sticky top-0 z-50 bg-brand-black/95 backdrop-blur border-b border-surface-3">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
    <a href={base} class="text-brand-orange font-bold text-xl tracking-wide whitespace-nowrap shrink-0">
      Warframe Codex
    </a>

    <nav aria-label="Primary navigation" class="hidden lg:flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {primaryLinks.map((link) => (
        <a
          href={link.href}
          class="nav-link"
          aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
        >{link.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <div
        id="pagefind-search"
        role="search"
        aria-label="Search the site"
        class="w-44 shrink-0 hidden sm:block"
      ></div>
      <button
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation"
        class="lg:hidden flex flex-col gap-1 p-2 rounded hover:bg-surface-2 transition-colors"
      >
        <span class="block w-5 h-0.5 bg-brand-cream/80"></span>
        <span class="block w-5 h-0.5 bg-brand-cream/80"></span>
        <span class="block w-5 h-0.5 bg-brand-cream/80"></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Mobile navigation"
    class="lg:hidden hidden border-t border-surface-3 bg-brand-black/95"
  >
    <div class="max-w-7xl mx-auto px-4 py-3 flex flex-col gap-1">
      {primaryLinks.map((link) => (
        <a
          href={link.href}
          class="nav-link py-2 border-b border-surface-3 last:border-0"
          aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
        >{link.label}</a>
      ))}
      <div
        id="pagefind-search-mobile"
        role="search"
        aria-label="Search the site (mobile)"
        class="w-full mt-2 sm:hidden"
      ></div>
    </div>
  </nav>
</header>

<style>
  .nav-link {
    color: rgb(232 222 200 / 0.75);
    transition: color 0.15s;
    border-radius: 0.25rem;
    outline: 2px solid transparent;
  }
  .nav-link:hover {
    color: #E89E3B;
  }
  .nav-link:focus-visible {
    outline: 2px solid #E89E3B;
    outline-offset: 2px;
  }
  .nav-link[aria-current='page'] {
    color: #E89E3B;
  }
</style>

<link rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
<script>
  window.addEventListener('DOMContentLoaded', () => {
    const win = window as Window & { PagefindUI?: new (opts: Record<string, unknown>) => void };
    if (typeof win.PagefindUI !== 'undefined') {
      new win.PagefindUI({ element: '#pagefind-search', showImages: false });
      const mobileEl = document.getElementById('pagefind-search-mobile');
      if (mobileEl) {
        new win.PagefindUI({ element: '#pagefind-search-mobile', showImages: false });
      }
    }

    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const isOpen = menu.classList.toggle('hidden') === false;
        toggle.setAttribute('aria-expanded', String(isOpen));
      });
    }
  });
</script>
<script define:vars={{ base }} is:inline>
  const s = document.createElement('script');
  s.src = base + 'pagefind/pagefind-ui.js';
  document.head.appendChild(s);
</script>
