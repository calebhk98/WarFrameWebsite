---
// LinkOutFandom — canonical link to warframe.fandom.com/wiki/<Name>
// name must be the canonical Wiki capitalised name (e.g. "Mag_Prime").
interface Props {
  name: string;
}

const { name } = Astro.props;
const url = `https://warframe.fandom.com/wiki/${encodeURIComponent(name)}`;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center gap-1 text-brand-orange hover:underline text-sm"
>
  <slot>View on Fandom wiki</slot>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 20 20"
    fill="currentColor"
    class="w-3 h-3 opacity-75"
    aria-hidden="true"
  >
    <path
      fill-rule="evenodd"
      d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z"
      clip-rule="evenodd"
    />
  </svg>
</a>
