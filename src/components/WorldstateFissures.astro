---
import type { Fissure } from '../lib/worldstate';

interface Props {
  fissures: Fissure[];
  steel: boolean;
  fetchedAt: string;
}

const { fissures, steel, fetchedAt } = Astro.props;

const TIER_ORDER: Record<string, number> = {
  Lith: 1, Meso: 2, Neo: 3, Axi: 4, Requiem: 5, Omnia: 6,
};

const active = fissures
  .filter((f) => !f.expired)
  .sort((a, b) => (TIER_ORDER[a.tier] ?? 99) - (TIER_ORDER[b.tier] ?? 99))
  .slice(0, 8);

const headingId = steel ? 'steel-fissures-heading' : 'fissures-heading';
const headingLabel = steel ? 'Steel Path Fissures' : 'Active Fissures';

const tierColors: Record<string, string> = {
  Lith: 'text-tier-b',
  Meso: 'text-tier-c',
  Neo: 'text-brand-cream',
  Axi: 'text-tier-s',
  Requiem: 'text-brand-purple',
  Omnia: 'text-brand-orange',
};

function formatExpiry(expiry: string): string {
  const diff = new Date(expiry).getTime() - Date.now();
  if (diff <= 0) return 'Expired';
  const h = Math.floor(diff / 3_600_000);
  const m = Math.floor((diff % 3_600_000) / 60_000);
  return h > 0 ? `${h}h ${m}m` : `${m}m`;
}
---

<section aria-labelledby={headingId} class="rounded-lg border border-surface-3 bg-surface-2 p-6">
  <div class="flex items-center justify-between mb-4">
    <h2 id={headingId} class="text-lg font-semibold text-brand-orange uppercase tracking-wide">
      {headingLabel}
    </h2>
    <time datetime={fetchedAt} class="text-xs text-brand-cream/40">
      Fetched {fetchedAt}
    </time>
  </div>

  {active.length === 0 && (
    <p class="text-brand-cream/60 text-sm italic">
      Live data unavailable. Try refreshing during a connected session.
    </p>
  )}

  {active.length > 0 && (
    <ul class="space-y-2" aria-label={`${headingLabel} list`}>
      {active.map((f) => (
        <li class="rounded bg-surface-3 px-4 py-3 text-sm flex flex-wrap items-center gap-2">
          <span class={`font-bold text-xs w-16 shrink-0 ${tierColors[f.tier] ?? 'text-brand-cream'}`}>
            {f.tier}
          </span>
          <span class="text-brand-cream font-medium flex-1">{f.node}</span>
          <span class="text-brand-cream/60">{f.missionType}</span>
          <span class="text-brand-orange text-xs">{formatExpiry(f.expiry)}</span>
        </li>
      ))}
    </ul>
  )}
</section>
