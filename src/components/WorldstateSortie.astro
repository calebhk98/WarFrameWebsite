---
import type { Sortie } from '../lib/worldstate';

interface Props {
  sortie: Sortie | null;
  fetchedAt: string;
}

const { sortie, fetchedAt } = Astro.props;

function formatExpiry(expiry: string): string {
  const diff = new Date(expiry).getTime() - Date.now();
  if (diff <= 0) return 'Expired';
  const h = Math.floor(diff / 3_600_000);
  const m = Math.floor((diff % 3_600_000) / 60_000);
  return h > 0 ? `${h}h ${m}m` : `${m}m`;
}
---

<section aria-labelledby="sortie-heading" class="rounded-lg border border-surface-3 bg-surface-2 p-6">
  <div class="flex items-center justify-between mb-4">
    <h2 id="sortie-heading" class="text-lg font-semibold text-brand-orange uppercase tracking-wide">
      Sortie
    </h2>
    <time datetime={fetchedAt} class="text-xs text-brand-cream/60">
      Fetched {fetchedAt}
    </time>
  </div>

  {!sortie && (
    <p class="text-brand-cream/60 text-sm italic">
      Live data unavailable. Try refreshing during a connected session.
    </p>
  )}

  {sortie && (
    <div>
      <div class="flex flex-wrap gap-3 mb-4 text-sm">
        <span class="px-2 py-1 rounded bg-surface-3 text-brand-cream font-semibold">
          {sortie.boss}
        </span>
        <span class="px-2 py-1 rounded bg-surface-3 text-brand-cream/70">
          {sortie.faction}
        </span>
        <span class="px-2 py-1 rounded bg-surface-3 text-brand-orange">
          Expires: {formatExpiry(sortie.expiry)}
        </span>
      </div>

      <ol class="space-y-2" aria-label="Sortie missions">
        {sortie.variants.map((v, i) => (
          <li class="rounded bg-surface-3 px-4 py-3 text-sm">
            <span class="text-brand-cream/60 text-xs mr-2">Stage {i + 1}</span>
            <span class="text-brand-cream font-medium">{v.missionTypeKey ?? v.missionType}</span>
            <span class="mx-2 text-brand-cream/50" aria-hidden="true">|</span>
            <span class="text-brand-cream/70">{v.nodeKey ?? v.node}</span>
            <p class="mt-1 text-brand-orange text-xs">{v.modifier}</p>
            {v.modifierDescription && (
              <p class="mt-0.5 text-brand-cream/60 text-xs">{v.modifierDescription}</p>
            )}
          </li>
        ))}
      </ol>
    </div>
  )}
</section>
