{
  "name": "warframe-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "import-wfcd": "tsx scripts/import-wfcd.ts",
    "import": "tsx scripts/import-wfcd.ts",
    "bundle:check": "bash scripts/check-bundle-size.sh",
    "html:check": "bash scripts/validate-html.sh",
    "verify": "pnpm typecheck && pnpm build && pnpm test && pnpm html:check && pnpm bundle:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^3.1.9",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.4",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^4.16.18",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "warframe-items": "^1.1269.87",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.0",
    "@types/node": "^22.10.6",
    "html-validate": "^11.2.0",
    "husky": "^9.1.7",
    "pagefind": "^1.3.0",
    "tsx": "^4.22.2",
    "vitest": "^2.1.8"
  }
}
